{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "cash_now": {
          "type": "string",
          "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
          "description": "Nonnegative decimal string; fractional places must not exceed currency.decimals."
        },
        "terms_complete": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "cash_now",
        "terms_complete"
      ]
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{2,11}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      },
      "required": [
        "code",
        "decimals"
      ]
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time",
      "description": "Explicit timezone, seconds required, 1970..2200. Recurrences use UTC."
    },
    "obligations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "enum": [
                  "PAYMENT"
                ]
              },
              "amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
                "description": "Nonnegative decimal string; fractional places must not exceed currency.decimals."
              },
              "frequency": {
                "type": "string",
                "enum": [
                  "ONCE",
                  "DAY",
                  "WEEK",
                  "MONTH",
                  "YEAR"
                ]
              },
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120
              },
              "starts_at": {
                "type": "string",
                "format": "date-time",
                "description": "Explicit timezone, seconds required, 1970..2200. Recurrences use UTC."
              },
              "ends_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Explicit timezone, seconds required, 1970..2200. Recurrences use UTC."
              },
              "occurrences": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              },
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": [
                      "TRUE",
                      "FALSE",
                      "UNKNOWN"
                    ]
                  },
                  "probability": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^(0(\\.\\d{1,6})?|1(\\.0{1,6})?)$"
                  }
                },
                "required": [
                  "state"
                ]
              },
              "cancellation": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allowed_until": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "description": "Explicit timezone, seconds required, 1970..2200. Recurrences use UTC."
                  }
                },
                "required": [
                  "allowed_until"
                ]
              },
              "minimum_commitment": {
                "type": "string",
                "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
                "description": "Nonnegative decimal string; fractional places must not exceed currency.decimals."
              },
              "termination_penalty": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
                "description": "Nonnegative decimal string; fractional places must not exceed currency.decimals."
              },
              "maximum_amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
                "description": "All-in total cap for this entire obligation including cancellation penalties, not a per-cycle cap."
              },
              "expected_amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
                "description": "Total continuing scenario estimate before condition probability, not per occurrence."
              }
            },
            "required": [
              "id",
              "kind",
              "amount",
              "frequency",
              "starts_at"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "enum": [
                  "AUTHORIZATION_HOLD"
                ]
              },
              "amount": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^\\d{1,15}(\\.\\d{1,6})?$",
                "description": "Nonnegative decimal string; fractional places must not exceed currency.decimals."
              },
              "starts_at": {
                "type": "string",
                "format": "date-time",
                "description": "Explicit timezone, seconds required, 1970..2200. Recurrences use UTC."
              },
              "release_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Explicit timezone, seconds required, 1970..2200. Recurrences use UTC."
              },
              "covers_obligation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "kind",
              "amount",
              "starts_at",
              "release_at"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "transaction",
    "currency",
    "evaluation_time",
    "obligations"
  ]
}
